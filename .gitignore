# =========================
# Node / npm
# =========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# =========================
# VS Code
# =========================
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# =========================
# OS junk
# =========================
.DS_Store
Thumbs.db
desktop.ini

# =========================
# Bitburner generated data
# =========================
data/history/*
!data/history/.gitkeep

# Optional:
# Ignore runtime state files
data/daemon-state.txt

# =========================
# Temp / logs
# =========================
*.log
tmp/
temp/

# =========================
# Build / cache
# =========================
dist/
coverage/
.cache/

# =========================
# Environment files
# =========================
.env
.env.local

# =========================
# Filesync local config
# =========================
filesync.json

# =========================
# Archive junk
# =========================
archive/*
!archive/.gitkeep