{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowJs": true,
        "checkJs": false,
        "baseUrl": ".",
        "ignoreDeprecations": "6.0",
        "paths": {
            "/*": [
                "./*"
            ]
        }
    },
    "include": [
        "**/*.js",
        "**/*.jsx"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "dashboard-ui/node_modules",
        "dashboard-ui/dist"
    ]
}